# Build-time origins for the RideArrivo public website.
# These values are examples only. Do not store secrets in this file.

# Canonical Arrivo Everywhere runtime used by ArrivoExpress.
ARRIVO_EVERYWHERE_ORIGIN=https://staging-express.ridearrivo.com

# Stable public website origin for the environment being built.
MAIN_SITE_ORIGIN=https://staging.ridearrivo.com

# Optional standalone Express build origin. The main website still owns /express.
EXPRESS_ORIGIN=https://staging.ridearrivo.com/express
