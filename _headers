# Private or one-time pages: keep them out of search results. robots.txt alone
# only asks crawlers not to fetch them; this header also stops a linked URL
# from being indexed.
/account
  X-Robots-Tag: noindex, nofollow
/account.html
  X-Robots-Tag: noindex, nofollow
/driver
  X-Robots-Tag: noindex, nofollow
/driver.html
  X-Robots-Tag: noindex, nofollow
