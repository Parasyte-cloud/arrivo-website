/marketing-consent.js
  Cache-Control: no-store, no-cache, must-revalidate

/marketing-consent.css
  Cache-Control: no-cache, must-revalidate

# Sign-in, account, driver and payment pages can only be framed by the site itself.
# The global policy above also lets the intranet frame public pages. Browsers enforce
# every Content-Security-Policy they receive, so this extra line wins on these paths.
/login
  Content-Security-Policy: frame-ancestors 'self'
/login.html
  Content-Security-Policy: frame-ancestors 'self'
/signup
  Content-Security-Policy: frame-ancestors 'self'
