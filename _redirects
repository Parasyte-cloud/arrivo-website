# ArrivoExpress is presented on the main RideArrivo website at /express. Cloudflare
# Pages already serves express.html at /express, so no rule is needed here. Do NOT
# add "/express /express.html 200": Pages redirects /express.html back to /express
# and the two rules loop forever (ERR_TOO_MANY_REDIRECTS).

# Internal files that sit in the repo root but are not part of the site. Cloudflare
# Pages serves every file in the repo, and _redirects cannot answer 404, so send
# these paths to the home page instead of serving the file. The build script still
# reads them from disk at build time; this only affects what visitors can fetch.
/docs /  302
/docs/* /  302
/scripts /  302
/scripts/* /  302
